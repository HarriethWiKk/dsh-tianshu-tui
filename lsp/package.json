{
  "name": "@huiliyi37/dsh-tui-lsp",
  "description": "LSP model-tool surface for the dsh harness: lsp_goto_definition / lsp_find_references / lsp_diagnostics tools plus a provide('lsp') service the TUI display bridge consumes (single LSP server set, no double spawn)",
  "version": "0.1.0-rc.6",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "keywords": [
    "dsh",
    "agent-harness",
    "lsp",
    "diagnostics",
    "terminal"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  }
}
