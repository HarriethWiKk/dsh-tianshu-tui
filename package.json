{
  "name": "@deepseek-ai/dsh-tianshu-tui",
  "description": "dsh code: an interactive TUI layer over the dsh-base profile, installable as a plugin (`dsh plugin --profile tui add @deepseek-ai/dsh-tianshu-tui`)",
  "version": "0.0.1-rc.2",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "NOTICE",
    "SOURCE-MAP.md"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "keywords": [
    "dsh",
    "agent-harness",
    "terminal",
    "tui",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-agent": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-permission-presets": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-workflow": "^0.0.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/cordis-plugin-include": "^0.0.1-rc.2",
    "@deepseek-ai/cordis-plugin-loader": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-agent": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-agent-default-model": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-agent-spine-demo": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-credentials-local": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-llm-replay": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-permission-presets": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-scope": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-settings-file": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-user-questions": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-workflow": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.0.1-rc.2"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "diff": "^9.0.0",
    "get-east-asian-width": "^1.6.0",
    "string-width": "^8.2.2"
  }
}