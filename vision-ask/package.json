  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-agent": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-attachment": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.2"
  }
